# Base URL of the Strapi backend (Render). Used by the SSR site fetch layer
# (src/lib/site.ts) to pull the "Personal Informations" single type.
#
# Two ways to set it:
#
# 1. RUNTIME (recommended for Cloudflare Workers):
#    Set STRAPI_URL as a Cloudflare Worker variable (dashboard or `wrangler vars set`).
#    No rebuild needed — just redeploy with `wrangler deploy`.
#
# 2. BUILD-TIME:
#    VITE_STRAPI_URL=https://your-backend.onrender.com npm run build
#    Then deploy the built .output with `wrangler deploy`.
#
# Example value:
# VITE_STRAPI_URL=https://strapi-unityaliving.onrender.com
